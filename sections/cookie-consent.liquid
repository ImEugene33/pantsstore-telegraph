{% comment %}
** Cookie consent banner - enabled through general settings **
Bottom-of-viewport non-blocking banner. Persists user choice via js-cookie
under the "cookie-consent" key with values "accepted" or "rejected".
{% endcomment %}

{% assign id = section.id %}
{% assign background_color = section.settings.background_color %}
{% assign text_color = section.settings.text_color %}
{% assign button_bg = section.settings.button_bg_color %}
{% assign button_text = section.settings.button_text_color %}
{% assign secondary_bg = section.settings.secondary_bg_color %}
{% assign secondary_text = section.settings.secondary_text_color %}
{% assign cookie_days = section.settings.cookie_days | default: 365 %}

{% style %}
  .cookie-consent {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 2147483647;
    background: {{ background_color }};
    color: {{ text_color }};
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    box-shadow: 0 -2px 12px rgba(0, 0, 0, 0.08);
    font-family: inherit;
  }

  .cookie-consent[hidden] {
    display: none;
  }

  .cookie-consent__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
    max-width: 1400px;
    margin: 0 auto;
    padding: 18px 24px;
  }

  .cookie-consent__text {
    flex: 1 1 auto;
    min-width: 0;
  }

  .cookie-consent__heading {
    font-family: 'Brandon Grotesque Bold', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.69px;
    font-size: 16px;
    line-height: 1.3;
    margin: 0 0 4px 0;
    color: {{ text_color }};
  }

  .cookie-consent__body {
    font-size: 14px;
    line-height: 1.5;
    margin: 0;
    color: {{ text_color }};
  }

  .cookie-consent__body a {
    color: {{ text_color }};
    text-decoration: underline;
  }

  .cookie-consent__body a:hover,
  .cookie-consent__body a:focus-visible {
    color: #3E862F;
  }

  .cookie-consent__body p {
    margin: 0;
  }

  .cookie-consent__actions {
    display: flex;
    align-items: center;
    gap: 12px;
    flex: 0 0 auto;
  }

  .cookie-consent__button {
    font-family: 'Brandon Grotesque Bold', sans-serif;
    text-transform: uppercase;
    letter-spacing: 0.69px;
    font-size: 13px;
    line-height: 1;
    padding: 12px 22px;
    border: 1px solid transparent;
    cursor: pointer;
    transition: opacity 0.15s ease;
  }

  .cookie-consent__button:hover {
    opacity: 0.85;
  }

  .cookie-consent__button:focus-visible {
    outline: 2px solid #000;
    outline-offset: 2px;
  }

  .cookie-consent__button--primary {
    background: {{ button_bg }};
    color: {{ button_text }};
    border-color: {{ button_bg }};
  }

  .cookie-consent__button--secondary {
    background: {{ secondary_bg }};
    color: {{ secondary_text }};
    border-color: {{ secondary_text }};
  }

  @media (max-width: 768px) {
    .cookie-consent__inner {
      flex-direction: column;
      align-items: stretch;
      gap: 14px;
      padding: 16px;
    }

    .cookie-consent__actions {
      justify-content: flex-end;
    }

    .cookie-consent__button {
      flex: 1 1 0;
      padding: 14px 18px;
    }
  }
{% endstyle %}

{% if section.settings.enabled %}
  <aside id="cookie-consent"
         class="cookie-consent"
         role="region"
         aria-label="{{ section.settings.aria_label | default: 'Cookie consent' }}"
         data-cookie-consent
         hidden>
    <div class="cookie-consent__inner">
      <div class="cookie-consent__text">
        {% if section.settings.heading != blank %}
          <h2 class="cookie-consent__heading">{{ section.settings.heading }}</h2>
        {% endif %}
        <div class="cookie-consent__body">
          {{ section.settings.body }}
        </div>
      </div>
      <div class="cookie-consent__actions">
        <button type="button"
                class="cookie-consent__button cookie-consent__button--secondary"
                data-cookie-reject>
          {{ section.settings.reject_label | default: 'Reject' }}
        </button>
        <button type="button"
                class="cookie-consent__button cookie-consent__button--primary"
                data-cookie-accept>
          {{ section.settings.accept_label | default: 'Accept' }}
        </button>
      </div>
    </div>
  </aside>

  <script type="application/json" data-section-id="{{ id }}" data-section-data>
    {
      "cookie_days": {{ cookie_days | json }}
    }
  </script>
  <script src="{{ 'z__jsCookieConsent.js' | asset_url }}" defer></script>
{% endif %}

{% schema %}
  {
    "name": "Cookie consent",
    "class": "cookie-consent-section jsCookieConsent",
    "settings": [
      {
        "type": "checkbox",
        "id": "enabled",
        "label": "Enable cookie consent banner",
        "default": true
      },
      {
        "type": "header",
        "content": "Content"
      },
      {
        "type": "text",
        "id": "heading",
        "label": "Heading",
        "default": "Cookie notice"
      },
      {
        "type": "richtext",
        "id": "body",
        "label": "Body",
        "default": "<p>We use cookies to improve your experience, personalize content, and analyze site traffic. See our <a href=\"/policies/privacy-policy\">Privacy Policy</a> for details.</p>"
      },
      {
        "type": "text",
        "id": "accept_label",
        "label": "Accept button label",
        "default": "Accept"
      },
      {
        "type": "text",
        "id": "reject_label",
        "label": "Reject button label",
        "default": "Reject"
      },
      {
        "type": "text",
        "id": "aria_label",
        "label": "Accessible region label",
        "default": "Cookie consent",
        "info": "Used by screen readers to identify this banner."
      },
      {
        "type": "header",
        "content": "Colors"
      },
      {
        "type": "color",
        "id": "background_color",
        "label": "Banner background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "text_color",
        "label": "Banner text",
        "default": "#1A1A1A"
      },
      {
        "type": "color",
        "id": "button_bg_color",
        "label": "Accept button background",
        "default": "#3E862F"
      },
      {
        "type": "color",
        "id": "button_text_color",
        "label": "Accept button text",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "secondary_bg_color",
        "label": "Reject button background",
        "default": "#FFFFFF"
      },
      {
        "type": "color",
        "id": "secondary_text_color",
        "label": "Reject button text",
        "default": "#1A1A1A"
      },
      {
        "type": "header",
        "content": "Behavior"
      },
      {
        "type": "select",
        "id": "cookie_days",
        "label": "Days to remember choice",
        "options": [
          { "value": "30",  "label": "30 days" },
          { "value": "60",  "label": "60 days" },
          { "value": "90",  "label": "90 days" },
          { "value": "180", "label": "180 days" },
          { "value": "365", "label": "365 days" }
        ],
        "default": "365"
      }
    ],
    "presets": [
      {
        "name": "Cookie consent"
      }
    ]
  }
{% endschema %}
